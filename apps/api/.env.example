NODE_ENV=development
PORT=8080
# Origin yang boleh memanggil API; * untuk development
ORIGIN=*
# URL publik API - dipakai membentuk statusURL dan URL unduh dokumen
SERVICE_URL=http://localhost:8080

# pp   : produksi - HMAC + verifikasi bearer pp-extended, provider & kuota dari admin-ppe
# none : lokal - tanpa kredensial sama sekali (JANGAN dipakai di produksi)
AUTH_MODE=pp

DATABASE_URL=postgresql://writer:writer@localhost:5433/writer_hub

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Penyimpanan dokumen ─────────────────────────────────────────────────────
# s3    : object storage (produksi)
# local : disk, disajikan lewat GET /api/v1/files/<key> (pengembangan)
STORAGE_DRIVER=s3
STORAGE_DIR=./storage

# Hanya wajib saat STORAGE_DRIVER=s3
CDN_BUCKET_NAME=
CDN_ENDPOINT=
# Belum ada yang membacanya - berkas disajikan lewat presigned URL
CDN_PUBLIC_URL=
CDN_ACCESS_KEY_ID=
CDN_SECRET_ACCESS_KEY=
CDN_REGION=us-east-1
# true untuk AWS S3 / DO Spaces. Kosongkan untuk MinIO / Cloudflare R2
# (keduanya menolak object ACL - pakai bucket policy).
S3_USE_OBJECT_ACL=

# Nama antrean - harus sama persis dengan services/worker
GRAMMAR_QUEUE_NAME=GRAMMAR_QUEUE
GRAMMAR_JOB_NAME=PROCESS_GRAMMAR
ANALYSIS_QUEUE_NAME=ANALYSIS_QUEUE
ANALYSIS_JOB_NAME=PROCESS_ANALYSIS

# Paksa semua job grammar ke satu tier. Produksi memakai `ai` karena provider
# berasal dari admin-ppe; kosongkan agar pilihan model dari klien dipakai.
GRAMMAR_FORCE_MODEL=ai

# ── Auth (hanya dipakai saat AUTH_MODE=pp) ──────────────────────────────────
# Secret HMAC bersama dengan pp-extended; apps/web memakai nilai yang sama
PP_API_KEY=
PP_BACKEND_URL=
PP_AUTH_CHECK_URL=
# Opsional - klien 'another-client' (header x-api-key)
API_KEYS=
# Opsional - klien 'ransel-ai' (header x-ransel-ai-api-key)
RANSEL_AI_API_KEY=

# ── admin-ppe: provider LLM & kuota ─────────────────────────────────────────
PP_EXTENDED_ADMIN_URL=
PP_EXTENDED_ADMIN_HMAC_SECRET=

# ── Provider AI cadangan ────────────────────────────────────────────────────
# Dipakai saat provider dari admin-ppe tidak tersedia. Pada AUTH_MODE=none
# admin-ppe tidak pernah dipanggil, jadi di pengembangan lokal ini satu-satunya
# sumber kredensial chat - tanpa AI_API_KEY, /chat membalas 503.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini

# ── Riset web (Tavily) ──────────────────────────────────────────────────────
# Wajib saat RESEARCH_ENABLED=true. Ambil di https://app.tavily.com
TAVILY_API_KEY=
RESEARCH_ENABLED=true
# Anggaran per giliran chat - tool editor lokal tidak ikut menghabiskannya.
# CATATAN: MAX_SEARCHES, MAX_EXTRACTS dan MAX_ROUNDS terbaca tapi belum
# ditegakkan di kode mana pun; lihat docs/WEB-RESEARCH-PLAN.md.
RESEARCH_MAX_SEARCHES=5
RESEARCH_MAX_EXTRACTS=8
RESEARCH_MAX_RESULTS=8
RESEARCH_MAX_ROUNDS=20
# Jatah karakter untuk seluruh satu panggilan fetch_url, dibagi rata antar halaman
RESEARCH_RESULT_CHARS=50000
# TTL cache Redis dalam detik: berita 3 jam, umum 24 jam
RESEARCH_CACHE_TTL_NEWS=10800
RESEARCH_CACHE_TTL_GENERAL=86400
# Domain yang tidak boleh jadi sumber, dipisah koma
RESEARCH_DENY_DOMAINS=
