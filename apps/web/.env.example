# URL internal apps/api. Hanya dibaca di server - browser selalu memanggil
# route proxy same-origin di /api/*, tidak pernah langsung ke apps/api.
API_URL=http://localhost:8080

# Harus cocok dengan AUTH_MODE di apps/api.
# none : proxy tidak menandatangani apa pun, semua kredensial di bawah diabaikan
# pp   : proxy menandatangani tiap request dengan HMAC
AUTH_MODE=pp

# Identitas klien yang dikirim sebagai header x-client.
# pp-extended | ransel-ai | another-client
API_CLIENT=pp-extended

# Kredensial sesuai API_CLIENT - semuanya rahasia sisi server.
# pp-extended: harus sama dengan PP_API_KEY di apps/api
PP_API_KEY=
# ransel-ai
RANSEL_AI_API_KEY=
# another-client
API_KEY=

# Cookie tempat token bearer user disimpan saat WritingHub berdiri sendiri.
# Kalau disematkan di shell yang meneruskan header Authorization, ini diabaikan.
AUTH_COOKIE_NAME=pp_token
