DATABASE_URL=postgresql://writer:writer@localhost:5432/writer_hub
REDIS_URL=redis://localhost:6379

# Harus sama persis dengan apps/api
GRAMMAR_QUEUE_NAME=GRAMMAR_QUEUE
GRAMMAR_JOB_NAME=PROCESS_GRAMMAR
ANALYSIS_QUEUE_NAME=ANALYSIS_QUEUE
ANALYSIS_JOB_NAME=PROCESS_ANALYSIS

GRAMMAR_LANGUAGE=en
EXTRACT_MAX_FILE_BYTES=10485760
EXTRACT_VERIFY_SSL=true

# Fallback POS tagger saja — provider LLM utama dikirim per job oleh apps/api.
# Biarkan AI_API_KEY kosong untuk menonaktifkan fallback ini.
AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini
AI_REFERER=
AI_APP_TITLE=writer-hub
