DATABASE_URL=postgresql://writer:writer@localhost:5432/writer_hub
REDIS_URL=redis://localhost:6379
GRAMMAR_QUEUE_NAME=GRAMMAR_QUEUE
GRAMMAR_JOB_NAME=PROCESS_GRAMMAR
ANALYSIS_QUEUE_NAME=ANALYSIS_QUEUE
ANALYSIS_JOB_NAME=PROCESS_ANALYSIS

GRAMMAR_LANGUAGE=en
EXTRACT_MAX_FILE_BYTES=10485760
EXTRACT_VERIFY_SSL=true
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini
AI_REFERER=
AI_APP_TITLE=writer-hub

# ── Render berkas (PDF) ─────────────────────────────────────────────────────
# Nama antrean harus sama persis dengan RENDER_QUEUE_NAME di apps/api.
RENDER_QUEUE_NAME=RENDER_QUEUE
# Alamat apps/web sebagaimana dilihat dari jaringan worker. Di dalam compose
# nilainya http://web:3000 (sudah disetel di docker-compose.yml).
RENDER_WEB_URL=http://localhost:3000
# Batas Chromium serentak; tiap instance ~250-400 MB.
RENDER_MAX_CONCURRENCY=2
# Tenggat satu render, dan tenggat mengantre sebelum job dilepas.
RENDER_PAGE_TIMEOUT_S=120
RENDER_QUEUE_TIMEOUT_S=300
# Plafon halaman satu render - berlaku untuk semua orang, bukan soal tier.
RENDER_MAX_PAGES=50
# Umur catatan status di Redis; sedikit lebih panjang dari lifecycle objeknya.
RENDER_RECORD_TTL_S=93600

# ── Penyimpanan objek ───────────────────────────────────────────────────────
# Hasil render diunggah ke bucket yang sama dengan apps/api, dengan prefix
# `exports/`. Nilainya harus sama persis dengan CDN_* di apps/api/.env -
# apps/api yang menerbitkan presigned URL atas objek yang ditulis worker ini.
CDN_ENDPOINT=
CDN_REGION=us-east-1
CDN_ACCESS_KEY_ID=
CDN_SECRET_ACCESS_KEY=
CDN_BUCKET_NAME=
