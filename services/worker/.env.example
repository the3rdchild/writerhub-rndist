DATABASE_URL=postgresql://writer:writer@localhost:5432/writer_hub
REDIS_URL=redis://localhost:6379

# Harus sama persis dengan apps/api
GRAMMAR_QUEUE_NAME=GRAMMAR_QUEUE
GRAMMAR_JOB_NAME=PROCESS_GRAMMAR
ANALYSIS_QUEUE_NAME=ANALYSIS_QUEUE
ANALYSIS_JOB_NAME=PROCESS_ANALYSIS

GRAMMAR_LANGUAGE=en
EXTRACT_MAX_FILE_BYTES=10485760
EXTRACT_VERIFY_SSL=true

# Ketahanan antrean (§P11). Bawaan di kode: JOB_DEADLINE_SECONDS=300,
# WORKER_CONCURRENCY=2. Batas waktu satu job; lewat itu job ditandai failed dan
# antrean maju, jadi satu job menggantung tidak membekukan fitur analisis.
# Ukur dulu tier AI pada naskah ~50 ribu karakter sebelum menguncinya.
# JOB_DEADLINE_SECONDS=300
# WORKER_CONCURRENCY=2

# Provider LLM. Di produksi dikirim per job oleh apps/api (hasil resolve
# admin-ppe); secara lokal worker memakai nilai di bawah ini.
#
# AI_BASE_URL harus BASE URL tanpa /chat/completions - worker yang menambahkannya.
# AI_MODEL di OpenRouter wajib memakai awalan vendor, mis. `deepseek/deepseek-v4-flash`.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini
AI_REFERER=
AI_APP_TITLE=writer-hub
